{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-lift.local/contracts/module-2/v2/realtime-race-protocol.schema.json",
  "title": "Never Lift Realtime Race Protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/joinRoomEnvelope" },
    { "$ref": "#/$defs/selectLoadoutEnvelope" },
    { "$ref": "#/$defs/readyEnvelope" },
    { "$ref": "#/$defs/inputEnvelope" },
    { "$ref": "#/$defs/roomStateEnvelope" },
    { "$ref": "#/$defs/countdownEnvelope" },
    { "$ref": "#/$defs/stateSnapshotEnvelope" },
    { "$ref": "#/$defs/raceEventEnvelope" },
    { "$ref": "#/$defs/raceResultEnvelope" },
    { "$ref": "#/$defs/errorEnvelope" }
  ],
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "joinRoomEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "join_room" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roomCode", "trackCatalogVersion", "physicsContractVersion"],
          "properties": {
            "roomCode": { "type": "string", "pattern": "^[A-Z0-9]{4,12}$" },
            "trackCatalogVersion": { "const": "2026.8" },
            "physicsContractVersion": { "const": "2.0.0" }
          }
        }
      }
    },
    "selectLoadoutEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "select_loadout" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color"],
          "properties": {
            "color": { "enum": ["#a84448", "#365f82", "#3f704f"] }
          }
        }
      }
    },
    "readyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "ready" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "inputEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "input" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["throttle", "brake", "steer", "clientSeq", "clientTimestamp"],
          "properties": {
            "throttle": { "type": "number", "minimum": 0, "maximum": 1 },
            "brake": { "type": "number", "minimum": 0, "maximum": 1 },
            "steer": { "type": "number", "minimum": -1, "maximum": 1 },
            "clientSeq": { "type": "integer", "minimum": 0 },
            "clientTimestamp": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "displayName", "color", "isBot"],
      "properties": {
        "playerId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "color": { "enum": ["#a84448", "#365f82", "#3f704f"] },
        "isBot": { "type": "boolean" }
      }
    },
    "roomSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "trackCatalogVersion", "physicsContractVersion"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "trackCatalogVersion": { "const": "2026.8" },
        "physicsContractVersion": { "const": "2.0.0" }
      }
    },
    "roomStateEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "room_state" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["players", "hostId", "settings", "readyStates"],
          "properties": {
            "players": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/player" } },
            "hostId": { "type": "string", "minLength": 1 },
            "settings": { "$ref": "#/$defs/roomSettings" },
            "readyStates": {
              "type": "object",
              "propertyNames": { "type": "string", "minLength": 1 },
              "additionalProperties": { "type": "boolean" }
            },
            "settingsLocked": { "type": "boolean" }
          }
        }
      }
    },
    "countdownEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "countdown" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startAtServerTime"],
          "properties": {
            "startAtServerTime": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "physicsState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yawRate", "steeringAngle", "appliedThrottle", "appliedBrake", "frontWheelAngularSpeed", "rearWheelAngularSpeed", "gear", "engineRpm", "gearShiftTimeRemaining"],
      "properties": {
        "yawRate": { "type": "number" },
        "steeringAngle": { "type": "number" },
        "appliedThrottle": { "type": "number", "minimum": 0, "maximum": 1 },
        "appliedBrake": { "type": "number", "minimum": 0, "maximum": 1 },
        "frontWheelAngularSpeed": { "type": "number" },
        "rearWheelAngularSpeed": { "type": "number" },
        "gear": { "type": "integer", "minimum": -1, "maximum": 8 },
        "engineRpm": { "type": "number", "minimum": 0 },
        "gearShiftTimeRemaining": { "type": "number", "minimum": 0 }
      }
    },
    "damageState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "engineDamaged", "steeringDamaged", "steeringPull", "totalLoss"],
      "properties": {
        "health": { "type": "number", "minimum": 0, "maximum": 100 },
        "engineDamaged": { "type": "boolean" },
        "steeringDamaged": { "type": "boolean" },
        "steeringPull": { "type": "number", "minimum": -1, "maximum": 1 },
        "totalLoss": { "type": "boolean" }
      }
    },
    "carSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "x", "y", "velocityX", "velocityY", "angle", "speed", "physicsState", "damageState", "lap", "isGhost", "inPit"],
      "properties": {
        "playerId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "velocityX": { "type": "number" },
        "velocityY": { "type": "number" },
        "angle": { "type": "number" },
        "speed": { "type": "number", "minimum": 0 },
        "physicsState": { "$ref": "#/$defs/physicsState" },
        "damageState": { "$ref": "#/$defs/damageState" },
        "lap": { "type": "integer", "minimum": 0 },
        "isGhost": { "type": "boolean" },
        "inPit": { "type": "boolean" }
      }
    },
    "stateSnapshotEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "state_snapshot" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tick", "serverTime", "physicsContractVersion", "cars"],
          "properties": {
            "tick": { "type": "integer", "minimum": 0 },
            "serverTime": { "type": "number", "minimum": 0 },
            "physicsContractVersion": { "const": "2.0.0" },
            "cars": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/carSnapshot" } }
          }
        }
      }
    },
    "raceEventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "race_event" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/collisionEvent" },
            { "$ref": "#/$defs/checkpointEvent" },
            { "$ref": "#/$defs/lapCompleteEvent" },
            { "$ref": "#/$defs/finishedEvent" },
            { "$ref": "#/$defs/falseStartEvent" },
            { "$ref": "#/$defs/pitEnterEvent" },
            { "$ref": "#/$defs/pitExitEvent" },
            { "$ref": "#/$defs/breakdownEvent" }
          ]
        }
      }
    },
    "collisionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId", "deltaVMetersPerSecond"],
      "properties": {
        "type": { "const": "collision" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 },
        "otherPlayerId": { "type": "string", "minLength": 1 },
        "barrierMaterial": { "enum": ["concrete-wall", "guardrail", "tecpro", "tyre-barrier"] },
        "deltaVMetersPerSecond": { "type": "number", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["otherPlayerId"] },
        { "required": ["barrierMaterial"] }
      ]
    },
    "checkpointEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId", "checkpointIndex", "lap"],
      "properties": {
        "type": { "const": "checkpoint" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 },
        "checkpointIndex": { "type": "integer", "minimum": 0 },
        "lap": { "type": "integer", "minimum": 0 }
      }
    },
    "lapCompleteEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId", "lap", "lapTimeMs"],
      "properties": {
        "type": { "const": "lap_complete" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 },
        "lap": { "type": "integer", "minimum": 1 },
        "lapTimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "finishedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId", "position", "totalTimeMs"],
      "properties": {
        "type": { "const": "finished" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "totalTimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "falseStartEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId", "penaltySeconds"],
      "properties": {
        "type": { "const": "false_start" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 },
        "penaltySeconds": { "type": "number", "minimum": 0 }
      }
    },
    "pitEnterEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId"],
      "properties": {
        "type": { "const": "pit_enter" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 }
      }
    },
    "pitExitEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId"],
      "properties": {
        "type": { "const": "pit_exit" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 }
      }
    },
    "breakdownEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tick", "playerId"],
      "properties": {
        "type": { "const": "breakdown" },
        "tick": { "type": "integer", "minimum": 0 },
        "playerId": { "type": "string", "minLength": 1 }
      }
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "position", "totalTimeMs", "bestLapTimeMs", "finished"],
      "properties": {
        "playerId": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "totalTimeMs": { "type": "integer", "minimum": 0 },
        "bestLapTimeMs": { "type": "integer", "minimum": 0 },
        "finished": { "type": "boolean" }
      }
    },
    "raceResultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "race_result" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standings"],
          "properties": {
            "standings": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/standing" } }
          }
        }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "error" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
