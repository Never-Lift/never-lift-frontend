{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-lift.local/contracts/module-2/v2/track-catalog.schema.json",
  "title": "Never Lift Track Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "physicsContractVersion",
    "seasonReference",
    "calendarPolicy",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "catalogVersion": {
      "const": "2026.9"
    },
    "seasonReference": {
      "const": 2026
    },
    "calendarPolicy": {
      "const": "original-24-round-freeze"
    },
    "tracks": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "id",
          "name",
          "countryCode",
          "countryName",
          "locality",
          "lengthMeters",
          "definitionPath"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "countryName": {
            "type": "string",
            "minLength": 1
          },
          "locality": {
            "type": "string",
            "minLength": 1
          },
          "lengthMeters": {
            "type": "integer",
            "minimum": 2500,
            "maximum": 8000
          },
          "definitionPath": {
            "type": "string",
            "pattern": "^tracks/[a-z0-9-]+\\.json$"
          }
        }
      }
    },
    "physicsContractVersion": {
      "const": "2.0.0"
    }
  }
}
