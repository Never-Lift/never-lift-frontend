{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-lift.local/contracts/module-2/v2/track-definition.schema.json",
  "title": "Never Lift Track Definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "physicsContractVersion",
    "id",
    "name",
    "countryCode",
    "locality",
    "lengthMeters",
    "coordinateSystem",
    "bounds",
    "centerline",
    "racingLine",
    "startFinish",
    "gridSlots",
    "checkpoints",
    "pitLane",
    "surfaceModel",
    "curbs",
    "trackLimits",
    "chunks",
    "sceneryLayout",
    "barrierGeometry",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "catalogVersion": {
      "const": "2026.7"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "locality": {
      "type": "string",
      "minLength": 1
    },
    "lengthMeters": {
      "type": "number",
      "minimum": 2500,
      "maximum": 8000
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "xAxis",
        "yAxis",
        "angleUnit",
        "angleDirection",
        "angleOrigin"
      ],
      "properties": {
        "unit": {
          "const": "meter"
        },
        "xAxis": {
          "const": "right"
        },
        "yAxis": {
          "const": "up"
        },
        "angleUnit": {
          "const": "radian"
        },
        "angleDirection": {
          "const": "counterclockwise"
        },
        "angleOrigin": {
          "const": "+x"
        }
      }
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "centerline": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/pathPoint"
      }
    },
    "racingLine": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/racingPoint"
      }
    },
    "startFinish": {
      "$ref": "#/$defs/gate"
    },
    "gridSlots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "angle"
        ],
        "properties": {
          "position": {
            "$ref": "#/$defs/vector"
          },
          "angle": {
            "type": "number"
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "pitLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryDistanceMeters",
        "exitDistanceMeters",
        "speedLimitMetersPerSecond",
        "path"
      ],
      "properties": {
        "entryDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "exitDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "speedLimitMetersPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "path": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/vector"
          }
        }
      }
    },
    "surfaceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onTrack",
        "pitLane"
      ],
      "properties": {
        "onTrack": {
          "const": "asphalt"
        },
        "pitLane": {
          "const": "pit-lane"
        }
      }
    },
    "curbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/curbSegment"
      }
    },
    "trackLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trackLimitSegment"
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "fromDistanceMeters",
          "toDistanceMeters",
          "bounds"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "fromDistanceMeters": {
            "type": "number",
            "minimum": 0
          },
          "toDistanceMeters": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bounds": {
            "$ref": "#/$defs/bounds"
          }
        }
      }
    },
    "sceneryLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "landmarks",
        "staticObjects"
      ],
      "properties": {
        "preset": {
          "enum": [
            "park",
            "street",
            "desert",
            "coastal",
            "classic",
            "night-city"
          ]
        },
        "landmarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneryObject"
          }
        },
        "staticObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneryObject"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "license",
        "url",
        "transformation",
        "environmentReferences"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "transformation": {
          "type": "string"
        },
        "environmentReferences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url",
              "checkedAt"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "checkedAt": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "physicsContractVersion": {
      "const": "2.0.0"
    },
    "barrierGeometry": {
      "$ref": "#/$defs/barrierGeometry"
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minX",
        "minY",
        "maxX",
        "maxY"
      ],
      "properties": {
        "minX": {
          "type": "number"
        },
        "minY": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "maxY": {
          "type": "number"
        }
      }
    },
    "pathPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "distanceMeters",
        "halfWidthMeters",
        "elevationLayer"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "halfWidthMeters": {
          "type": "number",
          "minimum": 3.5,
          "maximum": 13
        },
        "elevationLayer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "racingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "distanceMeters",
        "targetSpeedFactor"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "targetSpeedFactor": {
          "type": "number",
          "minimum": 0.35,
          "maximum": 1
        }
      }
    },
    "trackLimitSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "fromDistanceMeters",
        "toDistanceMeters",
        "left",
        "right"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "fromDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "toDistanceMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left": {
          "$ref": "#/$defs/trackSideEnvironment"
        },
        "right": {
          "$ref": "#/$defs/trackSideEnvironment"
        }
      }
    },
    "curbSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "fromDistanceMeters",
        "toDistanceMeters",
        "side",
        "widthMeters",
        "stripeLengthMeters",
        "palette"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "fromDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "toDistanceMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "widthMeters": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2.5
        },
        "stripeLengthMeters": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "palette": {
          "enum": [
            "red-white",
            "orange-white",
            "red-white-blue",
            "green-white-red",
            "red-yellow",
            "green-yellow",
            "maroon-white",
            "blue-white"
          ]
        }
      }
    },
    "trackSideEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zones",
        "barrier"
      ],
      "properties": {
        "zones": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "widthMeters"
            ],
            "properties": {
              "surface": {
                "enum": [
                  "asphalt",
                  "grass",
                  "gravel"
                ]
              },
              "widthMeters": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 60
              }
            }
          }
        },
        "barrier": {
          "enum": [
            "concrete-wall",
            "guardrail",
            "tecpro",
            "tyre-barrier"
          ]
        },
        "fence": {
          "const": "debris-fence"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "distanceMeters",
        "position",
        "forward",
        "halfWidthMeters"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/vector"
        },
        "forward": {
          "$ref": "#/$defs/vector"
        },
        "halfWidthMeters": {
          "type": "number",
          "minimum": 5,
          "maximum": 14
        }
      }
    },
    "sceneryObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "barrierFacePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "distanceMeters",
        "elevationLayer"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "elevationLayer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "barrierSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "trackLimitSegmentIndex",
        "side",
        "fromDistanceMeters",
        "toDistanceMeters",
        "material",
        "thicknessMeters",
        "collisionLayer",
        "chunkIndexes",
        "path"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "trackLimitSegmentIndex": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "fromDistanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "toDistanceMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "material": {
          "enum": [
            "concrete-wall",
            "guardrail",
            "tecpro",
            "tyre-barrier"
          ]
        },
        "thicknessMeters": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "collisionLayer": {
          "const": "track-barrier"
        },
        "chunkIndexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/barrierFacePoint"
          }
        }
      }
    },
    "barrierGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/barrierSegment"
          }
        }
      }
    }
  }
}
